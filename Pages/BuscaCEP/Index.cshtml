@page
@model MinhasFinancasWebApp.Pages.BuscaCEP.IndexModel
@{
	ViewData["Title"] = "Busca CEP";
}
<h1 class="mb-4">Busca CEP</h1>

@if (TempData["StatusErro"] != null)
{
	<div class="alert alert-danger">
		@TempData["StatusErro"]
	</div>
}


<form class="mb-4" method="post"
	  onsubmit="return confirmarConsulta()"
	  asp-page-handler="Cep">
	<!--	-->
	<div class="d-flex align-items-center gap-2">
		<label>CEP:</label>
		<input type="text" asp-for="CepConsultaText"
			   placeholder="00000-000" maxlength="9"
			   pattern="\d{5}-?\d{3}" oninput="formatarCep(this)"
			   class="form-control" style="max-width:130px;" />
		<button class="btn btn-success" type="submit">Consultar CEP</button>
		<a asp-page="/Menu" class="btn btn-secondary">Menu Principal</a>
	</div>
</form>

@if (TempData["StatusSucess"] != null)
{
	<div class="alert alert-success">
		@TempData["StatusSucess"]
	</div>
}

<div class="card">
	<div class="card-header">
		<h5>Resultado da consulta</h5>
	</div>
	@if (Model.CepResult != null)
	{
		<div class="card-body">
			<p><strong>CEP:</strong> @Model.CepResult.code</p>
			<p><strong>Logradouro:</strong> @Model.CepResult.address</p>
			<p><strong>Bairro:</strong> @Model.CepResult.district</p>
			<p><strong>Cidade:</strong> @Model.CepResult.city</p>
			<p><strong>UF:</strong> @Model.CepResult.state</p>
		</div>
	}
	else
	{
		<div class="card-body">
			<p class="text-muted">Consulte um CEP.</p>
		</div>
	}

</div>

<div class="card mt-2">
	<div class="card-header">
		<h5>Histórico de Consultas</h5>
	</div>
	<div class="card-body">
		@if (Model.CepList.Any())
		{
			<table class="table table-striped">
				<thead>
					<tr>
						<th>CEP</th>
						<th>Logradouro</th>
						<th>Bairro</th>
						<th>Cidade</th>
						<th>Estado</th>
						<th>Data Consulta</th>
						<th>Id Consulta</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.CepList)
					{
						<tr class="table-secondary">
							<td>@item.code</td>
							<td>@item.address</td>
							<td>@item.district</td>
							<td>@item.city</td>
							<td>@item.state</td>
							<td>@item.dataConsulta</td>
							<td>@item.Id</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="text-muted">Nenhum Registro Consultado</p>
		}
	</div>
</div>

@section Scripts {
	<script>
		function formatarCep(input){
			let x =	input.value.replace(/\D/g,"");

			if (x.length > 8){
				x = x.substring(0,8);
			}

			if(x.length > 5){
				x = x.substring(0,5)+"-"+x.substring(5);
			}

			input.value = x;
		}

		function confirmarConsulta(input){
			return confirm("Deseja consultar o CEP?");
		}

		@if (TempData["MensagemErro"] != null)
		{
				<text>
					alert('@TempData["MensagemErro"]');
				</text>
		}
	</script>
}